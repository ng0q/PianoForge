  "configuration": {
    "evaluation": {
      "event": "(midi_pitch, onset_s, offset_s)",
      "reference": "pretty_midi note-on/note-off; CC64 sustain is not applied",
      "pedal_extension": false,
      "pitch_hz": "440 * 2 ** ((midi_pitch - 69) / 12)",
      "function": "mir_eval.transcription.precision_recall_f1_overlap",
      "pitch_tolerance_cents": 50.0,
      "onset": {
        "onset_tolerance_s": 0.05,
        "offset_ratio": null,
        "pitch_tolerance_cents": 50.0
      },
      "onset_offset": {
        "onset_tolerance_s": 0.05,
        "offset_ratio": 0.2,
        "offset_min_tolerance_s": 0.05,
        "offset_tolerance": "max(50 ms, 20% of the reference note duration)",
        "pitch_tolerance_cents": 50.0
      },
      "drop_nonpositive_duration": true
    },
    "timing": {
      "warmup": "one untimed full transcription of the first recording, 01-iPad_psycho.wav",
      "latency": "perf_counter from the model's audio read through the note list",
      "includes": [
        "preprocessing",
        "inference",
        "decoding"
      ],
      "excludes": [
        "model load",
        "metric computation"
      ],
      "accelerator_sync": "before the timer starts and before it stops",
      "rtf": "latency_s / audio_duration_s",
      "overall_rtf": "sum(latency_s) / sum(audio_duration_s) over successful recordings",
      "median_latency": "median of per-recording latency_s",
      "vram_poll": "AMT_VRAM_POLL=0, so the MPS figure is the allocated memory read on the inference thread after each recording, not a sampled peak"
    },
    "inference": {
      "hft_transformer": {
        "mode": "combination",
        "scored_output": "2nd",
        "n_stride": 0,
        "ablation": false,
        "thred_onset": 0.5,
        "thred_offset": 0.5,
        "thred_mpe": 0.5,
        "mode_velocity": "ignore_zero",
        "mode_offset": "shorter",
        "config": "corpus/config.json plus min_value=log(log_offset) and max_value=0 from corpus/make_dataset.py",
        "preprocessing": "AMT.wav2feature",
        "decoding": "AMT.transcript + AMT.mpe2note"
      },
      "transkun_v2": {
        "segmentHopSizeInSecond": 8,
        "segmentSizeInSecond": 16,
        "discardSecondHalf": false,
        "mergeIncompleteEvent": true,
        "fs": 44100,
        "audio_normalization": "int16 / 2**15",
        "resample": "soxr to model.fs when the file rate differs",
        "wav_reader": "pydub.AudioSegment.from_file; upstream readAudio calls from_mp3",
        "note_filter": "pitch > 0, matching Data.writeMidi",
        "decoding": "ModelTransformer.transcribe",
        "config": "model.conf inside the Google Drive archive. scoringExpansionFactor=2 and contextDropoutProb=0.1. The repository file pretrained/2.0.conf belongs to Transkun V2 No Pedal Ext and is not used."
      },
      "hrt": {
        "model_type": "Note_pedal",
        "segment_samples": 160000,
        "forward_batch_size": 1,
        "onset_threshold": 0.3,
        "offset_threshold": 0.3,
        "frame_threshold": 0.1,
        "pedal_offset_threshold": 0.2,
        "sample_rate": 16000,
        "preprocessing": "piano_transcription_inference.utilities.load_audio",
        "decoding": "RegressionPostProcessor.output_dict_to_midi_events"
      },
      "sft_crnn": {
        "config": "config/main_config.yaml via hydra, experiment_optTransportLoss",
        "n_frames": 1200,
        "dropout_rate": 0.0,
        "training_mode": "test",
        "batch_inference": 64,
        "onset_offset_threshold": 0.5,
        "sample_rate": 48000,
        "hop_length": 1200,
        "features": "cqt",
        "amplitude_to_db": true,
        "duration_clip_s": [
          0.05,
          10.0
        ],
        "precision": "float32; upstream inference.py autocasts float16 on CUDA only",
        "preprocessing": "librosa.load + nnAudio CQT + AmplitudeToDB, as inference.py",
        "decoding": "data.notes_parser.pianoroll_to_notes_list"
      }
    },
    "device_request": "mps",
    "models_not_run": [
      "onsets_frames"
    ]
  },
